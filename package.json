{
  "name": "@labourchain/core-plugins",
  "version": "0.0.0",
  "description": "Deterministic core chain plugins for LabourChain",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./plugin": "./lib/plugin.js",
    "./record": "./lib/record.js",
    "./entity": "./lib/entity.js",
    "./block": "./lib/block.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:artifacts": "pnpm run build && node scripts/build-core-artifacts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build:artifacts && node scripts/smoke-package-exports.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
