{
  "name": "@labourchain/system-protocols",
  "version": "0.0.0",
  "description": "Executable system protocol implementations for LabourChain",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./sys-blockheader-v1": "./lib/protocols/sys-blockheader-v1.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "schemas/**/*.cue",
    "README.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
